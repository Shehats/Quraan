{
  "compilerOptions": {
    "target": "ES5",
    "module": "none",
    "lib": ["ES5", "DOM", "ES2015.Promise"],
    "outFile": "js/app.js",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": ["src/tizen.d.ts", "src/api.ts", "src/player.ts", "src/app.ts"]
}
